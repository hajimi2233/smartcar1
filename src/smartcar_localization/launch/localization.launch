<launch>
  <arg name="map_file" /><arg name="params" />
  <arg name="wall_features" default="false" />
  <arg name="walls_file" default="/tmp/localization_walls.json" />
  <arg name="region_file" default="/tmp/external_region.json" />
  <arg name="nav_config" default="" />
  <arg name="scan_odometry" default="true" />
  <arg name="scan_topic" default="/scan" />
  <arg name="base_frame" default="base_footprint" /><arg name="odom_frame" default="odom" /><arg name="map_frame" default="map" />
  <rosparam command="load" file="$(arg params)" />
  <include if="$(arg scan_odometry)" file="$(find smartcar_localization)/launch/frontend.launch">
    <arg name="scan_topic" value="$(arg scan_topic)" /><arg name="base_frame" value="$(arg base_frame)" /><arg name="odom_frame" value="$(arg odom_frame)" />
  </include>
  <node pkg="map_server" type="map_server" name="slam_map_server" args="$(arg map_file)" required="true">
    <param name="frame_id" value="$(arg map_frame)" />
  </node>
  <node unless="$(arg wall_features)" pkg="amcl" type="amcl" name="amcl" output="screen" required="true">
    <param name="base_frame_id" value="$(arg base_frame)" /><param name="odom_frame_id" value="$(arg odom_frame)" /><param name="global_frame_id" value="$(arg map_frame)" />
    <remap from="scan" to="$(arg scan_topic)" />
  </node>
  <group if="$(arg wall_features)">
    <include file="$(find smartcar_navigation)/launch/corridor.launch">
      <arg name="config_file" value="$(arg nav_config)" />
      <arg name="region_file" value="$(arg region_file)" />
    </include>
    <node pkg="smartcar_localization" type="wall_editor.py" name="wall_editor" output="screen" required="true">
      <param name="file" value="$(arg walls_file)" />
      <param name="map_frame" value="$(arg map_frame)" />
    </node>
    <node pkg="smartcar_localization" type="wall_localizer.py" name="wall_localizer" output="screen" required="true">
      <param name="map_frame" value="$(arg map_frame)" />
      <param name="base_frame" value="$(arg base_frame)" />
      <param name="odom_frame" value="$(arg odom_frame)" />
      <remap from="scan" to="$(arg scan_topic)" />
    </node>
  </group>
</launch>
