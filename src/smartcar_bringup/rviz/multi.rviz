Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Tool Properties
    Expanded: true
    Name: Tool Properties
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 40; 40; 45
    Fixed Frame: map
    Frame Rate: 10
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz/Map
      Name: SLAM map
      Enabled: true
      Topic: /map
      Alpha: 0.85
      Color Scheme: map
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz/MarkerArray
      Name: Robot footprint
      Enabled: true
      Marker Topic: /nav/robot_body
    - Class: rviz/LaserScan
      Name: Live lidar
      Enabled: false
      Topic: /scan
      Size (m): 0.06
      Style: Squares
      Color Transformer: FlatColor
      Color: 255; 30; 30
    - Class: rviz/PointCloud2
      Name: Live scan in map
      Enabled: true
      Topic: /scan_in_map
      Size (m): 0.05
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 40; 40
    - Class: rviz/MarkerArray
      Name: Waypoints
      Enabled: true
      Marker Topic: /waypoint_marks
    - Class: rviz/MarkerArray
      Name: Inspection preview
      Enabled: false
      Marker Topic: /inspection/preview
    - Class: rviz/Marker
      Name: Nav goal
      Enabled: true
      Marker Topic: /nav/goal_mark
    - Class: rviz/Marker
      Name: Low-cost planning lines
      Enabled: true
      Marker Topic: /single_nav/zero_cost_line
    - Class: rviz/Path
      Name: Nav path
      Enabled: true
      Topic: /single_nav/path
      Color: 0; 200; 80
    - Class: rviz/Path
      Name: Local trajectory
      Enabled: true
      Topic: /single_nav/local_path
      Color: 255; 180; 0
    - Class: rviz/Pose
      Name: Virtual test pose
      Enabled: true
      Topic: /single_nav/virtual_pose
      Shape: Arrow
      Color: 80; 255; 220
      Axes Length: 0.6
      Axes Radius: 0.04
    - Class: rviz/Marker
      Name: Virtual test arrow
      Enabled: true
      Marker Topic: /single_nav/virtual_marker
    - Class: rviz/PoseWithCovariance
      Name: AMCL pose
      Enabled: true
      Topic: /amcl_pose
    - Class: rviz/PoseArray
      Name: AMCL particles
      Enabled: false
      Topic: /particlecloud
    - Class: rviz/MarkerArray
      Name: Corridor region
      Enabled: true
      Marker Topic: /external_region/markers
    - Class: rviz/Marker
      Name: Corridor state
      Enabled: true
      Marker Topic: /corridor/marker
    - Class: rviz/MarkerArray
      Name: Localization walls
      Enabled: true
      Marker Topic: /wall_features/markers
    - Class: rviz/PoseWithCovariance
      Name: Wall feature pose
      Enabled: true
      Topic: /wall_localization/pose
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: smartcar_region_tool/SetWallPoint
      Single click: false
      Topic: /wall_features/point
    - Class: smartcar_region_tool/DrawRegion
      Single click: false
      Topic: /external_region/corner
    - Class: smartcar_region_tool/SetLinePoint
      Single click: false
      Topic: /single_nav/line_point

    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /multi_nav/goal
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top down
      Angle: 0
      Scale: 50
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1200
  Height: 800
