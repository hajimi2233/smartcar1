# Interface contract only; execution server is supplied by the navigation team.
# This file is not built by the Windows C demo.
uint8 AUTO=0
uint8 FORWARD_ONLY=1
uint8 REVERSE_ONLY=2
uint8 PUBLIC_ONLY=0
uint8 CHANNEL_WITH_PORTALS=1
uint64 mission_id
uint32 task_id
string target_id
# target_pose refers to the front axle midpoint, not an implicit base_link.
string map_id
string map_version
string target_reference
geometry_msgs/PoseStamped target_pose
# If false, target_pose orientation is unused. Never interpret zero yaw as a goal.
bool enforce_yaw
uint8 motion_mode
uint8 path_scope
uint8 column_id
uint8 region_id
string phase
bool inspect
bool stop_at_goal
---
bool success
string error_message
---
geometry_msgs/PoseStamped current_pose
string status
