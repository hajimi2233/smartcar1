<launch>
  <arg default="true" name="gui" /><arg default="true" name="rviz" />
  <arg default="A1A2B3B4A5B6A7B8A9B10" name="layout" />
  <arg default="/home/hajimi/smartcar_2026_ws/data/maps/sim_field_v1" name="data_dir" />
  <env name="GAZEBO_MODEL_DATABASE_URI" value="" />
  
  <param name="use_sim_time" value="true" />
  <rosparam file="$(find smartcar_sim)/config/vehicle.yaml" ns="sim" />
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find smartcar_sim)/worlds/inspection.world" />
    <arg name="gui" value="$(arg gui)" />
  </include>
  <param name="robot_description" textfile="$(find smartcar_description)/urdf/inspection_car.urdf" />
  <node args="-urdf -param robot_description -model inspection_car -x 3.86 -y 2.8 -z 0.015 -Y 3.141592653589793" name="spawn_car" output="screen" pkg="gazebo_ros" type="spawn_model" />
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <remap from="joint_states" to="/sim/joint_states" />
  </node>
  <node args="$(arg data_dir)/map.yaml" name="sim_reference_map" pkg="map_server" type="map_server">
    <param name="frame_id" value="sim_world" />
    <remap from="map" to="/geometry_map" />
    <remap from="static_map" to="/geometry_static_map" />
  </node>
  <node name="inspection_preview" output="screen" pkg="smartcar_inspection" type="preview.py">
    <param name="map_info" value="$(arg data_dir)/map_info.txt" /><param name="points" value="$(arg data_dir)/points.csv" />
    <param name="output" value="/home/hajimi/smartcar_2026_ws/data/logs/inspection_preview" /><param name="layout" value="$(arg layout)" />
  </node>
  <node args="-d $(find smartcar_sim)/config/inspection.rviz" if="$(arg rviz)" name="inspection_rviz" pkg="rviz" type="rviz">
    <env name="OGRE_RTT_MODE" value="Copy" />
    <env name="QT_X11_NO_MITSHM" value="1" />
    <env name="QT_AUTO_SCREEN_SCALE_FACTOR" value="0" />
  </node>
  <arg name="localization" default="true" />
  <include if="$(arg localization)" file="$(find smartcar_navigation)/launch/localization.launch" />
</launch>
