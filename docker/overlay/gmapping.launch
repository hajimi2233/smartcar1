<launch>
  <!-- Use while simulation is already running. The local odom frame comes
       from laser_scan_matcher (IMU disabled by default); it is not wheel odometry. -->
  <arg name="scan_topic" default="/scan" />
  <arg name="sim_imu" default="false" />
  <node pkg="smartcar_navigation" type="laser_noise.py" name="laser_noise" output="screen" />
  <node if="$(arg sim_imu)" pkg="smartcar_navigation" type="imu_bridge.py" name="imu_bridge" output="screen">
    <param name="input_topic" value="/sim/imu" />
    <param name="output_topic" value="/imu/data" />
  </node>
  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node"
        name="laser_scan_matcher_node" output="screen">
    <param name="max_iterations" value="10" />
    <param name="base_frame" value="base_footprint" />
    <param name="fixed_frame" value="odom" />
    <param name="use_odom" value="false" />
    <param name="use_imu" value="$(arg sim_imu)" />
    <param name="publish_tf" value="true" />
    <remap from="scan" to="$(arg scan_topic)" />
    <remap from="imu" to="/imu/data" />
  </node>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="$(arg scan_topic)" />
    <param name="base_frame" value="base_footprint" />
    <param name="odom_frame" value="odom" />
    <param name="map_frame" value="map" />
    <param name="map_update_interval" value="1.0" />
    <param name="maxUrange" value="12.0" />
    <param name="maxRange" value="25.0" />
    <param name="xmin" value="-8.0" />
    <param name="ymin" value="-6.0" />
    <param name="xmax" value="8.0" />
    <param name="ymax" value="6.0" />
    <param name="delta" value="0.05" />
    <param name="linearUpdate" value="0.15" />
    <param name="angularUpdate" value="0.12" />
    <param name="temporalUpdate" value="0.5" />
    <param name="particles" value="40" />
    <param name="resampleThreshold" value="0.5" />
    <param name="minimumScore" value="50" />
    <param name="srr" value="0.05" />
    <param name="srt" value="0.05" />
    <param name="str" value="0.05" />
    <param name="stt" value="0.05" />
    <param name="occ_thresh" value="0.25" />
  </node>
</launch>
