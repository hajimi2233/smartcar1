<launch>
  <arg name="scan_topic" default="/scan" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="odom_frame" default="odom" />
  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node" name="laser_scan_matcher_node" output="screen" required="true">
    <param name="max_iterations" value="10" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="fixed_frame" value="$(arg odom_frame)" />
    <param name="use_odom" value="false" /><param name="use_imu" value="false" />
    <param name="publish_tf" value="true" />
    <remap from="scan" to="$(arg scan_topic)" />
  </node>
</launch>
